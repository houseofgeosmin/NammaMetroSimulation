{
  "buildCommand": "",
  "installCommand": "",
  "framework": null,
  "outputDirectory": "site",
  "cleanUrls": true,
  "crons": [{ "path": "/api/keepalive", "schedule": "17 3 * * *" }],
  "headers": [
    { "source": "/ride-log-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/ride-log" }] },
    { "source": "/ride-log/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
